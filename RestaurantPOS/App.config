<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!--
      Update Server/Database/User/Password to match your SQL Server instance.
      Windows Authentication example:
      Server=localhost;Database=RestaurantPOSDB;Trusted_Connection=True;TrustServerCertificate=True;

      SQL Authentication example:
      Server=localhost;Database=RestaurantPOSDB;User Id=sa;Password=YourPassword;TrustServerCertificate=True;
    -->
    <add name="RestaurantPOSDB"
         connectionString="Server=DESKTOP-25UVR8A\SQLEXPRESS02;Database=RestaurantPOSDB;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="DefaultTaxRate" value="10.00" />
    <add key="CurrencySymbol" value="$" />
  </appSettings>
</configuration>
